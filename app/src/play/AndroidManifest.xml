<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build. Play keeps USE_EXACT_ALARM for alarm, timer and calendar apps, so the user allows exact
     alarms once (Ready to snipe opens the page). Battery is set on Android's own page, with no direct exemption
     request. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

</manifest>
